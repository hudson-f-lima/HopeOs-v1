# Servidor local do backend
PORT=3333
NODE_ENV=development

# Pasta de dados do modo local
DATA_DIR=../data

# Supabase do HOPE OS: projeto hopeos-v1 (gsttjozcmdvgstcpadiq). NUNCA o kortex-os-v2-staging.
# Chave secreta só no backend; nunca no frontend.
SUPABASE_URL=https://gsttjozcmdvgstcpadiq.supabase.co
SUPABASE_SECRET_KEY=COLE_AQUI_SOMENTE_NO_BACKEND

# Empresa usada só pelo token legado (transição)
DEFAULT_EMPRESA_ID=00000000-0000-0000-0000-000000000001
API_ACCESS_TOKEN=gere-um-token-longo-aleatorio
LEGACY_TOKEN_AUTH_ENABLED=true

# URL pública da PWA (links de convite e recuperação de senha)
APP_PUBLIC_URL=http://localhost:5599
APP_TIMEZONE=America/Sao_Paulo

# Origens liberadas para CORS (separadas por vírgula; nunca *)
CORS_ORIGIN=http://localhost:5599,http://127.0.0.1:5599

# Agendamento online: desligado sem esta variável. Ex.: {"meu-salao":"<uuid da empresa>"}
# PUBLIC_BOOKING_LINKS=
